# Local KnowledgeOS configuration.
# Copy to .env and adjust. Values are read by the backend process.

# Storage
KNOWLEDGEOS_DATA_DIR=data
KNOWLEDGEOS_WORKERS=4
KNOWLEDGEOS_MAX_UPLOAD_BYTES=536870912
KNOWLEDGEOS_MAX_BATCH_FILES=10000

# Local embeddings (Ollama)
KNOWLEDGEOS_OLLAMA_BASE_URL=http://127.0.0.1:11434
KNOWLEDGEOS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGEOS_OLLAMA_AUTO_START=true
KNOWLEDGEOS_OLLAMA_AUTO_PULL=true

# Security. Leave the secrets unset to generate persistent values in the data
# directory (mode 600); set strong explicit values outside local development.
# KNOWLEDGEOS_AUTH_SECRET=
# KNOWLEDGEOS_ENCRYPTION_KEY=
KNOWLEDGEOS_ALLOW_ANONYMOUS=true
KNOWLEDGEOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chunking and answer quality
KNOWLEDGEOS_CHUNK_SIZE=1200
KNOWLEDGEOS_CHUNK_OVERLAP=180
KNOWLEDGEOS_ABSTAIN_THRESHOLD=0.6
KNOWLEDGEOS_NLI_ENABLED=true
KNOWLEDGEOS_NLI_THRESHOLD=0.5
KNOWLEDGEOS_NLI_MAX_CLAIMS=20
KNOWLEDGEOS_PROMPT_INJECTION_GUARD=true
KNOWLEDGEOS_ALLOW_HASH_EMBEDDING_FALLBACK=false
KNOWLEDGEOS_DENSE_SCAN_LIMIT=50000

# Answer cache
KNOWLEDGEOS_CACHE_TTL_SECONDS=604800
KNOWLEDGEOS_CACHE_SEMANTIC_ENABLED=false
KNOWLEDGEOS_CACHE_SIMILARITY=0.92
KNOWLEDGEOS_CACHE_DISABLED_DURING_EVAL=true

# Frontend (optional). This is an origin without /api; the client appends it.
# Leave empty to use the Vite development proxy or the nginx /api proxy.
# VITE_KNOWLEDGEOS_API_URL=http://localhost:8000
