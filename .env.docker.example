# Docker Compose defaults. Copy this file to .env at the repository root:
#   cp .env.docker.example .env
KNOWLEDGEOS_HTTP_PORT=8080
KNOWLEDGEOS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGEOS_ALLOW_HASH_EMBEDDING_FALLBACK=false
KNOWLEDGEOS_ALLOW_ANONYMOUS=true
KNOWLEDGEOS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
KNOWLEDGEOS_MAX_UPLOAD_BYTES=536870912
KNOWLEDGEOS_WORKERS=4

# Leave empty to generate persistent secrets under /data/secrets (recommended
# for local Compose use). Set strong values for a shared deployment.
KNOWLEDGEOS_AUTH_SECRET=
KNOWLEDGEOS_ENCRYPTION_KEY=
