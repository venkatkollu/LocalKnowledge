# Copy this file to .env before running `docker compose up --build`.
# .env is gitignored and must never be committed.

# Host port for the web UI.
KNOWLEDGEOS_HTTP_PORT=8080

# Embedding model pulled into the Ollama container on first start.
# all-minilm is small and fast; use bge-m3 for higher retrieval quality.
KNOWLEDGEOS_OLLAMA_EMBEDDING_MODEL=all-minilm

# Local mode is anonymous. Set false and configure AUTH_SECRET to require
# bearer tokens (the browser must send one; see README).
KNOWLEDGEOS_ALLOW_ANONYMOUS=true

# Browser origins allowed to call the API directly (comma separated).
KNOWLEDGEOS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Ingestion and concurrency limits.
KNOWLEDGEOS_MAX_UPLOAD_BYTES=536870912
KNOWLEDGEOS_WORKERS=4

# Never enable the deterministic hash embedding in production.
KNOWLEDGEOS_ALLOW_HASH_EMBEDDING_FALLBACK=false

# Secrets are generated once and persisted inside the knowledgeos-data volume
# when these are left blank. Set them explicitly to use Docker/Compose secrets
# or an external secret manager.
#   Auth secret:      python3 -c "import secrets; print(secrets.token_hex(32))"
#   Encryption key:   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KNOWLEDGEOS_AUTH_SECRET=
KNOWLEDGEOS_ENCRYPTION_KEY=
